// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
    id  Int @id @default(autoincrement())
    username String @unique
    passwordHash String 
    role Role @default(USER)
    createdAt DateTime @default(now())

    swipes Swipe[]
} 

enum Role {
  ADMIN
  USER
}


model Incident {

  id Int  @id @default(autoincrement())
  title String 
  description String
  homeTeam String
  awayTeam String 
  createdAt DateTime @default(now())
  realDecision Decision 
  // must add relation to reference each incident to a law

  swipes Swipe[]
}

enum Decision {
  PENALTY
  NO_PENALTY
  RED_CARD
  YELLOW_CARD
  OFFSIDE
  NO_OFFSIDE
}

model Swipe {
  id Int @id @default(autoincrement())
  userId Int
  incidentId Int
  decision Decision
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id])
  incident Incident @relation(fields: [incidentId], references: [id])
    @@unique([userId, incidentId]) // Ensure a user can only swipe once per incident
}